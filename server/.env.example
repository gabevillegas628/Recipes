# Copy to .env for local development.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/recipes
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Optional; defaults to ./uploads at the repo root.
# UPLOAD_DIR=./uploads
# Optional. Enables AI extraction for pages without structured recipe data, and "paste text" import.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional; defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
# Optional; model for sorting grocery items into aisles. Defaults to claude-haiku-4-5.
# GROCERY_MODEL=claude-haiku-4-5
# Optional; model for combining amounts across recipes. Defaults to claude-sonnet-5.
# GROCERY_TOTALS_MODEL=claude-sonnet-5
# Optional. Base URL for the connector link and recipe links returned to Claude
# (defaults to the request's host).
# PUBLIC_URL=https://your-app.up.railway.app
