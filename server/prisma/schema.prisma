generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  passwordHash      String
  isAdmin           Boolean            @default(false)
  createdAt         DateTime           @default(now())
  recipes           Recipe[]
  importJobs        ImportJob[]
  connectorTokens   ConnectorToken[]
  planItems         PlanItem[]
  groceryItems      GroceryItem[]
  meals             Meal[]
  notes             Note[]
  googleConnections GoogleConnection[]
  financeConnections FinanceConnection[]
}

enum RecipeSource {
  URL
  CLAUDE
  MANUAL
}

model Recipe {
  id              String             @id @default(cuid())
  title           String
  description     String?
  source          RecipeSource       @default(MANUAL)
  sourceUrl       String?
  /// Filename inside UPLOAD_DIR, served at /images/<image>
  image           String?
  servings        String?
  prepMinutes     Int?
  cookMinutes     Int?
  totalMinutes    Int?
  /// Section[]: [{ title: string | null, items: string[] }]
  ingredients     Json               @default("[]")
  /// Section[]: [{ title: string | null, items: string[] }]
  instructions    Json               @default("[]")
  notes           String?
  favorite        Boolean            @default(false)
  /// Set when the recipe was extracted by AI rather than structured data; cleared on the next manual save.
  needsReview     Boolean            @default(false)
  tags            Tag[]
  createdBy       User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  importJobs      ImportJob[]
  planItems       PlanItem[]
  groceryItems    GroceryItem[]
  mealRecipes     MealRecipe[]
  prep            RecipePrep?
  ingredientIndex RecipeIngredients?

  @@index([createdAt])
  @@index([sourceUrl])
}

enum ImportStatus {
  PENDING
  RUNNING
  DONE
  DUPLICATE
  FAILED
}

/// One URL from a bulk import. Processed in the background by the import worker.
model ImportJob {
  id          String       @id @default(cuid())
  url         String
  status      ImportStatus @default(PENDING)
  /// How the recipe was found: jsonld | microdata | ai
  method      String?
  error       String?
  recipe      Recipe?      @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId    String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

model Tag {
  id      String   @id @default(cuid())
  name    String   @unique
  recipes Recipe[]
}

/// Secret for the Claude connector URL (/mcp/<token>). Only a SHA-256 hash is stored;
/// the token itself is shown once when generated.
model ConnectorToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
}

/// A recipe on "This week". Drops off automatically 7 days after it was added.
model PlanItem {
  id         String    @id @default(cuid())
  recipe     Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId   String
  /// Serving multiplier chosen when planning (1 = as written).
  scale      Float     @default(1)
  addedBy    User?     @relation(fields: [addedById], references: [id], onDelete: SetNull)
  addedById  String?
  /// Set when the recipe was added as part of a meal; the Week tab groups by it.
  meal       Meal?     @relation(fields: [mealId], references: [id], onDelete: SetNull)
  mealId     String?
  createdAt  DateTime  @default(now())
  cookedAt   DateTime?
  archivedAt DateTime?

  @@index([archivedAt, createdAt])
}

/// One line on the shared grocery list.
model GroceryItem {
  id          String    @id @default(cuid())
  text        String
  /// Store section, e.g. "Produce". Null until sorted, or when AI sorting is unavailable.
  aisle       String?
  /// Plain item name ("carrots") shared by lines for the same thing, so they show as one row.
  /// Null until sorted.
  name        String?
  checked     Boolean   @default(false)
  checkedAt   DateTime?
  recipe      Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId    String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([checked, createdAt])
}

/// Cached mise en place plan (see src/prep.ts). Rebuilt when the recipe's
/// ingredients or steps no longer match the hash.
model RecipePrep {
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String   @id
  hash      String
  plan      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Each ingredient line read as name, amount and unit (see src/ingredients.ts), for
/// planning recipes that share ingredients. Rebuilt when the ingredients no longer match the hash.
model RecipeIngredients {
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String   @id
  hash      String
  /// A dish that's dinner by itself, not a side or sauce; the planner only suggests these.
  main      Boolean  @default(true)
  /// IndexedItem[]: [{ line, name, amount, unit, kind }]
  items     Json
  updatedAt DateTime @updatedAt
}

/// Store section learned from past sorts, keyed by the bare item name ("lemon").
/// Lets repeat items skip the AI call.
model GroceryAisle {
  name      String   @id
  aisle     String
  /// The plain item name the AI gave it ("garlic" for "cloves garlic").
  item      String?
  updatedAt DateTime @updatedAt
}

/// One amount to buy for several lines of the same item ("2 lb + 3 carrots" -> "about 3 lb"),
/// estimated by AI. Valid only while `sources` still matches the lines on the list.
model GroceryTotal {
  name      String   @id
  sources   String
  buy       String
  updatedAt DateTime @updatedAt
}

/// A named set of recipes cooked together: "Taco night", "Thanksgiving".
model Meal {
  id          String       @id @default(cuid())
  name        String
  notes       String?
  /// How many people the meal serves as defined; the meal's servings stepper scales from this.
  servings    Int?
  recipes     MealRecipe[]
  planItems   PlanItem[]
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model MealRecipe {
  meal     Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId   String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
  /// Order within the meal.
  position Int
  /// This recipe's amount within the meal (2 = double the mashed potatoes).
  scale    Float  @default(1)

  @@id([mealId, recipeId])
  @@index([recipeId])
}

enum NoteKind {
  NOTE
  REMINDER
  APPOINTMENT
}

/// A note, reminder or appointment, shared by everyone. Usually sorted by AI from
/// something typed, dictated or photographed (see src/capture.ts).
model Note {
  id               String    @id @default(cuid())
  kind             NoteKind  @default(NOTE)
  title            String
  body             String?
  /// When an appointment starts, or when a reminder is due. All-day dates are stored
  /// at 12:00 UTC on that date, so they read as the same day in any US time zone.
  startsAt         DateTime?
  endsAt           DateTime?
  allDay           Boolean   @default(false)
  location         String?
  /// Notes only: the group it's filed under ("Medical", "Work"), or null. Named by people and capture; no fixed list.
  group            String?
  /// Repeats: an RRULE such as "FREQ=WEEKLY;BYDAY=TU" (see src/recurrence.ts). startsAt is the first occurrence.
  recurrence       String?
  /// A photo kept with it (the flyer it came from), stored like recipe images.
  image            String?
  /// Reminders only: ticked off.
  doneAt           DateTime?
  /// The matching Google Calendar event (see src/calendarSync.ts), and the calendar it's on.
  googleEventId    String?
  googleCalendarId String?
  /// Changed since it was last written to Google Calendar.
  syncPending      Boolean   @default(false)
  /// Why Google Calendar rejected it, if it did.
  syncError        String?
  createdBy        User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([kind, startsAt])
  @@index([syncPending])
}

/// The Google account the app writes calendar events with. At most one row (id "default").
model GoogleConnection {
  id                    String   @id @default("default")
  email                 String?
  /// Encrypted with a key derived from SESSION_SECRET (see src/google.ts).
  refreshToken          String
  calendarId            String?
  calendarName          String?
  /// The calendar's time zone (IANA), which Google needs for repeating events.
  timeZone              String?
  /// Where reminders go instead, if set (say, one person's own calendar). They alert at the due time.
  remindersCalendarId   String?
  remindersCalendarName String?
  /// Google's event color for reminders, "1"-"11" (see GOOGLE_COLORS in google.ts); null for the calendar's color.
  remindersColor        String?
  /// Where the app lives, for "open in the app" links in event descriptions.
  appUrl                String
  /// Set when Google stops accepting the connection (revoked, expired); needs reconnecting.
  error                 String?
  connectedBy           User?    @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedById         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Who's in the family, for finding times (see src/findTime.ts).
model HouseholdPerson {
  id       String   @id @default(cuid())
  name     String
  /// Other ways calendar titles refer to them: nicknames, initials.
  aliases  String[]
  /// Kids have school hours and need an adult along.
  adult    Boolean  @default(true)
  position Int      @default(0)
}

/// Settings for finding a time. One row (id "default").
model Household {
  id            String   @id @default("default")
  /// Kids' school on weekdays, "07:20" to "14:50". Times during school count as "better to avoid". Null to ignore.
  schoolStart   String?
  schoolEnd     String?
  /// Added before and after a new appointment for getting there and back.
  travelMinutes Int      @default(45)
  /// Usual hours for appointments, on weekdays.
  hoursStart    String   @default("08:00")
  hoursEnd      String   @default("17:00")
  /// When the day's free time is counted on Today, every day: "07:00" to "21:00".
  dayStart      String   @default("07:00")
  dayEnd        String   @default("21:00")
  /// Where Today's weather is for: the place as shown ("Austin, Texas") and its coordinates.
  weatherPlace  String?
  weatherLat    Float?
  weatherLon    Float?
  updatedAt     DateTime @updatedAt
}

/// Who a calendar event is for, by its title, as the AI read it or as corrected by hand.
model EventTag {
  /// The title, lowercased with spaces collapsed (see src/eventTags.ts).
  title     String   @id
  /// HouseholdPerson ids.
  people    String[]
  /// The whole family, or someone outside it (a birthday party).
  everyone  Boolean  @default(false)
  /// No one could be told from the title; treated as everyone.
  unsure    Boolean  @default(false)
  byHand    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ---------- Money (see src/money/) ----------

/// The SimpleFIN Bridge connection bank, card and Fidelity data comes from. At most one row (id "default").
model FinanceConnection {
  id            String    @id @default("default")
  /// SimpleFIN's access URL, credentials included, encrypted with a key derived from SESSION_SECRET.
  accessUrl     String
  /// Set when SimpleFIN stops accepting the access URL; needs a new setup token.
  error         String?
  /// What SimpleFIN said was wrong on the last sync (a bank wanting its sign-in redone). Syncing still works.
  warnings      String[]
  lastSyncAt    DateTime?
  /// When the first sync finished reaching back for older history. Null until then.
  backfilledAt  DateTime?
  connectedBy   User?     @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum FinanceAccountKind {
  CHECKING
  SAVINGS
  CREDIT_CARD
  LOAN
  INVESTMENT
  OTHER
}

/// A bank account, card, loan or investment account, as SimpleFIN reports it.
model FinanceAccount {
  id               String               @id @default(cuid())
  /// SimpleFIN's account id.
  externalId       String               @unique
  institution      String
  name             String
  /// Guessed from the name on first sync; changed by hand in Settings → Money.
  kind             FinanceAccountKind
  kindByHand       Boolean              @default(false)
  /// As the bank reports it: negative for what's owed on cards and loans.
  balance          Decimal              @db.Decimal(14, 2)
  availableBalance Decimal?             @db.Decimal(14, 2)
  balanceDate      DateTime
  /// Investment positions as SimpleFIN sends them, replaced on each sync.
  holdings         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  transactions     FinanceTransaction[]
  balances         FinanceBalance[]
}

/// One charge, payment, deposit or transfer on an account.
model FinanceTransaction {
  id           String         @id @default(cuid())
  account      FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId    String
  /// SimpleFIN's transaction id, or "csv:" and a hash of the row for imported history.
  externalId   String
  /// When the purchase was made (posted date if the bank doesn't say). Months count by this.
  transactedAt DateTime
  postedAt     DateTime?
  /// Negative is money out of this account (a purchase on a card, a bill paid from checking).
  amount       Decimal        @db.Decimal(14, 2)
  description  String
  payee        String?
  memo         String?
  pending      Boolean        @default(false)
  /// "simplefin" or "csv".
  source       String         @default("simplefin")
  /// merchantKey() of the description; how it finds its FinanceMerchant.
  merchantKey  String?
  /// What the money was (see src/money/classify.ts). Null until sorted.
  kind         FinanceKind?
  /// For spending (and refunds, which are spending with a plus sign).
  category     FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId   String?
  /// The same money seen from our other account: the card's side of a card payment.
  pairId       String?        @unique
  /// Kind and category picked for this one transaction; sorting leaves it alone.
  byHand       Boolean        @default(false)
  /// Sorting couldn't settle it (Zelle, cash, a merchant the AI wasn't sure of).
  needsLook    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([accountId, externalId])
  @@index([transactedAt])
  @@index([merchantKey])
}

enum FinanceKind {
  /// Purchases and bills. A plus amount is a refund or someone paying us back.
  SPENDING
  INCOME
  /// Between our own accounts (card payments); not counted.
  TRANSFER
  /// Into savings or investments. A plus amount is taking some back out.
  SAVING
}

/// What money is spent on. Starts with a default list; edited in Settings → Money.
model FinanceCategory {
  id           String               @id @default(cuid())
  name         String               @unique
  /// Fixed costs (insurance, car payments) vs. flexible ones (groceries, dining).
  fixed        Boolean              @default(false)
  position     Int                  @default(0)
  merchants    FinanceMerchant[]
  transactions FinanceTransaction[]
}

/// How a merchant's transactions are sorted: read by AI once, or set by hand. Like EventTag.
model FinanceMerchant {
  /// merchantKey() of a transaction description.
  key        String           @id
  /// The merchant as people say it ("Kroger"). Every store of a chain shares it, and a correction applies to all of them.
  name       String
  kind       FinanceKind?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  /// The AI couldn't tell (Zelle to a person, a cash withdrawal).
  unsure     Boolean          @default(false)
  byHand     Boolean          @default(false)
  updatedAt  DateTime         @updatedAt

  @@index([name])
}

/// An account's balance at the end of a day, for net worth over time.
model FinanceBalance {
  account   FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  date      DateTime       @db.Date
  balance   Decimal        @db.Decimal(14, 2)

  @@id([accountId, date])
}
