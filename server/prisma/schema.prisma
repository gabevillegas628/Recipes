generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  passwordHash    String
  createdAt       DateTime         @default(now())
  recipes         Recipe[]
  importJobs      ImportJob[]
  connectorTokens ConnectorToken[]
}

enum RecipeSource {
  URL
  CLAUDE
  MANUAL
}

model Recipe {
  id           String       @id @default(cuid())
  title        String
  description  String?
  source       RecipeSource @default(MANUAL)
  sourceUrl    String?
  /// Filename inside UPLOAD_DIR, served at /images/<image>
  image        String?
  servings     String?
  prepMinutes  Int?
  cookMinutes  Int?
  totalMinutes Int?
  /// Section[]: [{ title: string | null, items: string[] }]
  ingredients  Json         @default("[]")
  /// Section[]: [{ title: string | null, items: string[] }]
  instructions Json         @default("[]")
  notes        String?
  favorite     Boolean      @default(false)
  /// Set when the recipe was extracted by AI rather than structured data; cleared on the next manual save.
  needsReview  Boolean      @default(false)
  tags         Tag[]
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  importJobs   ImportJob[]

  @@index([createdAt])
  @@index([sourceUrl])
}

enum ImportStatus {
  PENDING
  RUNNING
  DONE
  DUPLICATE
  FAILED
}

/// One URL from a bulk import. Processed in the background by the import worker.
model ImportJob {
  id          String       @id @default(cuid())
  url         String
  status      ImportStatus @default(PENDING)
  /// How the recipe was found: jsonld | microdata | ai
  method      String?
  error       String?
  recipe      Recipe?      @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId    String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

model Tag {
  id      String   @id @default(cuid())
  name    String   @unique
  recipes Recipe[]
}

/// Secret for the Claude connector URL (/mcp/<token>). Only a SHA-256 hash is stored;
/// the token itself is shown once when generated.
model ConnectorToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
}
